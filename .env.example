# AI Engineer Assessment - Production Suite Configuration Template
# Copy this file to .env and configure credentials as needed.
# Note: The system features built-in local emulation for speech, retrieval, and audio streaming,
# so all 4 assessment questions can run completely offline without requiring paid API keys!

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=production
LOG_LEVEL=INFO

# Optional External AI / LLM Providers (Defaults to local embedded engines if omitted)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Speech-to-Text (ASR) Services
DEEPGRAM_API_KEY=your_deepgram_api_key_here
GOOGLE_APPLICATION_CREDENTIALS=path/to/google_creds.json

# Optional Text-to-Speech (TTS) Services
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus

# Telephony / Webhook Integration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_CALLABLE_NUMBER=+15550109988
CRM_WEBHOOK_URL=http://127.0.0.1:8000/api/leads
